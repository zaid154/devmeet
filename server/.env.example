# Backend Environment Variables (Production & Local)
PORT=3000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/developer_meetups?retryWrites=true&w=majority
JWT_PVT_KEY=replace_with_a_long_random_64_char_secret
FRONTEND_URL=https://your-frontend-domain.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend-domain.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend-domain.vercel.app

# Admin Seed Credentials (used by server/seedUsers.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=Admin User

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=developer-meetups

# Brevo / Email (Recommended for Render)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional: SMTP Fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
